generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum RoleCode {
  PATIENT
  CAREGIVER
  ADMIN
}

enum DocumentType {
  RUT
  DNI
  PASSPORT
  OTHER
}

enum AppointmentStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum ReminderType {
  GENERAL
  MEDICATION
  EXAM
}

enum ReminderFrequencyUnit {
  HOURS
  DAYS
  WEEKS
}

enum ReminderLogStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum MedicalHistorySource {
  APPOINTMENT
  MANUAL
}

enum MedicalHistoryType {
  DIAGNOSIS
  CONCLUSION
  FOLLOW_UP
  PATIENT_NOTE
  EXAM
  PRESCRIPTION
  OTHER
}

model User {
  id          String      @id @default(uuid())
  email       String
  passwordHash String
  firstName   String
  lastName    String
  status      UserStatus  @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  // relations
  patientProfile                   Patient?                   @relation("patient_user")
  createdPatients                  Patient[]                  @relation("patients_created_by")
  updatedPatients                  Patient[]                  @relation("patients_updated_by")
  guardianLinks                    PatientGuardian[]          @relation("patient_guardian_user")
  createdGuardianLinks             PatientGuardian[]          @relation("patient_guardian_created_by")
  recordedAppointments             Appointment[]              @relation("appointments_recorded_by")
  uploadedAttachments              AppointmentAttachment[]
  createdReminders                 Reminder[]                 @relation("reminders_created_by")
  updatedReminders                 Reminder[]                 @relation("reminders_updated_by")
  createdReminderLogs              ReminderLog[]              @relation("reminder_logs_created_by")
  createdMedicalHistoryEntries     MedicalHistoryEntry[]      @relation("medical_history_entries_created_by")
  updatedMedicalHistoryEntries     MedicalHistoryEntry[]      @relation("medical_history_entries_updated_by")
  uploadedMedicalHistoryAttachments MedicalHistoryAttachment[] @relation("medical_history_attachments_uploaded_by")
  refreshTokens                    RefreshToken[]
  userRoles                        UserRole[]

  @@unique([email])
  @@index([status])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  code        RoleCode  @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model Patient {
  id                     String        @id @default(uuid())
  userId                 String?       @unique
  documentType           DocumentType
  documentNumber         String
  firstName              String
  lastName               String
  birthDate              DateTime?
  email                  String?
  phone                  String?
  timezone               String        @default("America/Santiago")
  addressLine            String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  notes                  String?
  isActive               Boolean       @default(true)
  createdByUserId        String?
  updatedByUserId        String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime?

  user        User? @relation("patient_user", fields: [userId], references: [id])
  createdBy   User? @relation("patients_created_by", fields: [createdByUserId], references: [id])
  updatedBy   User? @relation("patients_updated_by", fields: [updatedByUserId], references: [id])

  guardians             PatientGuardian[]
  appointments          Appointment[]
  reminders             Reminder[]
  reminderLogs          ReminderLog[]
  medicalHistoryEntries MedicalHistoryEntry[]

  @@unique([documentType, documentNumber])
  @@index([lastName, firstName])
  @@index([documentNumber])
  @@map("patients")
}

model PatientGuardian {
  id                    String    @id @default(uuid())
  patientId             String
  guardianUserId        String
  relationship          String?
  canEditProfile        Boolean   @default(true)
  canManageAppointments Boolean   @default(true)
  isActive              Boolean   @default(true)
  createdByUserId       String
  invitationToken       String?   @unique
  invitationExpiresAt   DateTime?
  invitedAt             DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  guardianUser User    @relation("patient_guardian_user", fields: [guardianUserId], references: [id], onDelete: Cascade)
  createdBy    User    @relation("patient_guardian_created_by", fields: [createdByUserId], references: [id])

  @@unique([patientId, guardianUserId, isActive])
  @@index([guardianUserId])
  @@index([patientId, isActive])
  @@map("patient_guardians")
}

model Appointment {
  id               String            @id @default(uuid())
  patientId        String
  recordedByUserId String
  startsAt         DateTime
  endsAt           DateTime?
  status           AppointmentStatus @default(PLANNED)
  reason           String?
  facilityName     String?
  facilityAddress  String?
  doctorName       String?
  specialty        String?
  wasAttended      Boolean?
  diagnosis        String?
  conclusion       String?
  followUpNotes    String?
  cancelledReason  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  patient               Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedByUser        User                    @relation("appointments_recorded_by", fields: [recordedByUserId], references: [id])
  attachments           AppointmentAttachment[]
  medicalHistoryEntries MedicalHistoryEntry[]

  @@index([patientId, startsAt(sort: Desc)])
  @@index([status, startsAt])
  @@index([recordedByUserId])
  @@map("appointments")
}

model AppointmentAttachment {
  id               String   @id @default(uuid())
  appointmentId    String
  uploadedByUserId String
  fileName         String
  fileUrl          String
  mimeType         String
  fileSizeBytes    BigInt?
  createdAt        DateTime @default(now())

  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  uploadedByUser User        @relation(fields: [uploadedByUserId], references: [id])

  @@index([appointmentId, createdAt(sort: Desc)])
  @@map("appointment_attachments")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Reminder {
  id                String                @id @default(uuid())
  patientId         String
  createdByUserId   String
  updatedByUserId   String?
  type              ReminderType
  name              String
  timeOfDay         String
  dosageAmount      String?
  frequencyEvery    Int
  frequencyUnit     ReminderFrequencyUnit
  startsOn          DateTime
  untilOn           DateTime?
  notes             String?
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdByUser  User          @relation("reminders_created_by", fields: [createdByUserId], references: [id])
  updatedByUser  User?         @relation("reminders_updated_by", fields: [updatedByUserId], references: [id])
  logs           ReminderLog[]

  @@index([patientId, isActive])
  @@index([patientId, type])
  @@index([patientId, startsOn, untilOn])
  @@map("reminders")
}

model ReminderLog {
  id              String            @id @default(uuid())
  reminderId      String
  patientId       String
  scheduledFor    DateTime
  status          ReminderLogStatus @default(PENDING)
  completedAt     DateTime?
  skipReason      String?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  reminder      Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdByUser User     @relation("reminder_logs_created_by", fields: [createdByUserId], references: [id])

  @@unique([reminderId, scheduledFor])
  @@index([patientId, scheduledFor(sort: Desc)])
  @@index([reminderId, scheduledFor(sort: Desc)])
  @@index([status, scheduledFor])
  @@map("reminder_logs")
}

model MedicalHistoryEntry {
  id              String               @id @default(uuid())
  patientId       String
  source          MedicalHistorySource
  type            MedicalHistoryType
  title           String
  description     String?
  occurredAt      DateTime
  appointmentId   String?
  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  patient     Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy   User                       @relation("medical_history_entries_created_by", fields: [createdByUserId], references: [id])
  updatedBy   User?                      @relation("medical_history_entries_updated_by", fields: [updatedByUserId], references: [id])
  attachments MedicalHistoryAttachment[]

  @@index([patientId, occurredAt(sort: Desc)])
  @@index([patientId, source])
  @@index([patientId, type])
  @@index([appointmentId])
  @@map("medical_history_entries")
}

model MedicalHistoryAttachment {
  id               String   @id @default(uuid())
  entryId          String
  fileName         String
  fileMimeType     String
  fileSizeBytes    Int
  s3Bucket         String
  s3Key            String   @unique
  uploadedByUserId String
  createdAt        DateTime @default(now())

  entry      MedicalHistoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  uploadedBy User                @relation("medical_history_attachments_uploaded_by", fields: [uploadedByUserId], references: [id])

  @@index([entryId])
  @@map("medical_history_attachments")
}
